  "willingness_levels": [
    {
      "level": "resistant",
      "definition": "债务人明确拒绝还款，或表现出强烈的对抗、回避态度，无任何协商或还款意愿的迹象。",
      "boundary": "与下一级‘weak’的区别在于：resistant 是主动拒绝或攻击性回避，而 weak 是消极应付但未明确拒绝。resistant 通常伴随情绪化语言（如‘别烦我’‘我没钱’），而 weak 更多是含糊拖延（如‘再说吧’）。",
      "example_turns": [
        {
          "text": "我没钱还，你们再打电话我就报警了。",
          "reason": "明确拒绝还款并威胁报警，属于典型的对抗性抵抗，无任何配合倾向。"
        }
      ]
    },
    {
      "level": "weak",
      "definition": "债务人表现出低意愿或被动应付，可能以模糊理由拖延，但未明确拒绝，也未提出具体还款方案。",
      "boundary": "与上一级‘resistant’的区别：weak 不包含直接拒绝或攻击，而是含糊其辞；与下一级‘conditional’的区别：weak 没有提出任何条件或具体承诺，而 conditional 开始提出‘如果…就…’的协商框架。",
      "example_turns": [
        {
          "text": "我现在手头紧，过段时间再说吧。",
          "reason": "用模糊的时间借口拖延，没有给出具体日期或金额，属于低意愿的被动应付。"
        }
      ]
    },
    {
      "level": "conditional",
      "definition": "债务人开始提出还款的前提条件或限制性要求，表明有还款意愿但附加了约束（如时间、金额、减免等）。",
      "boundary": "与上一级‘weak’的区别：conditional 有明确的‘如果…就…’结构，而非单纯拖延；与下一级‘negotiating’的区别：conditional 是提出单方面条件，而 negotiating 是双方互动讨价还价。",
      "example_turns": [
        {
          "text": "如果你们能减免利息，我下个月可以还本金。",
          "reason": "提出了‘减免利息’作为还款前提，属于有条件配合，但尚未进入双向协商。"
        }
      ]
    },
    {
      "level": "negotiating",
      "definition": "债务人与催收方进行双向协商，讨论具体还款方案（如分期、延期、金额调整），表现出积极解决问题的态度。",
      "boundary": "与上一级‘conditional’的区别：negotiating 是双方互动，包含让步或讨价还价，而非单方面提条件；与下一级‘strong’的区别：negotiating 仍处于讨论阶段，尚未做出明确承诺或行动。",
      "example_turns": [
        {
          "text": "我最多能先还500，剩下的能不能分三个月？",
          "reason": "主动提出具体金额和分期方案，并寻求对方同意，属于典型的协商行为。"
        }
      ]
    },
    {
      "level": "strong",
      "definition": "债务人明确承诺还款，并给出具体时间、金额或行动方案，表现出高度配合和履约意愿。",
      "boundary": "与上一级‘negotiating’的区别：strong 不再讨论条件，而是直接承诺或确认执行；与更低等级的区别：strong 包含确定性语言（如‘我保证’‘明天一定’），而非试探或条件。",
      "example_turns": [
        {
          "text": "我明天下午三点前一定把2000元转到指定账户。",
          "reason": "给出了具体时间、金额和行动方式，属于明确且强烈的还款承诺。"
        }
      ]
    }
  ],
